<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_textmeflow" model="ir.ui.view">
        <field name="name">res.partner.form.textmeflow</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_textmeflow_send" type="object" class="oe_stat_button" icon="fa-whatsapp"
                        invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Send via WhatsApp</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="textmeflow_optin"/>
                <field name="textmeflow_optin_date" invisible="not textmeflow_optin"/>
            </xpath>
        </field>
    </record>
</odoo>
