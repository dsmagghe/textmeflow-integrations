<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_textmeflow" model="ir.ui.view">
        <field name="name">account.move.form.textmeflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_textmeflow_send" type="object" string="Send via WhatsApp"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
