msgid "WhatsApp connected"
msgstr "WhatsApp verbunden"

#: includes/class-textmeflow-admin.php:112
msgid "Your WhatsApp number is not linked yet."
msgstr "Deine WhatsApp-Nummer ist noch nicht verknüpft."

