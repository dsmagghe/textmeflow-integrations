<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="textmeflow_send_wizard_view_form" model="ir.ui.view">
        <field name="name">textmeflow.send.wizard.form</field>
        <field name="model">textmeflow.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send via WhatsApp">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="allowed_template_ids" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="phone"/>
                    <field name="optin"/>
                    <field name="template_id" domain="[('id', 'in', allowed_template_ids)]" options="{'no_create': True}"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="optin">
                    This contact has not agreed to WhatsApp messages yet. Ask for consent first, then tick the box above.
                </div>
                <field name="body" required="1" placeholder="Your message"/>
                <footer>
                    <button string="Send" type="object" name="action_send" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
