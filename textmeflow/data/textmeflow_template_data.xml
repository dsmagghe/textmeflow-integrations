        <field name="lang">en</field>
        <field name="body">Hi {first_name}, invoice {invoice_number} ({invoice_total}) from {shop_name} is ready. View it here: {portal_url}</field>
    </record>
    <record id="template_invoice_posted_nl" model="textmeflow.template">
        <field name="event">invoice_posted</field>
        <field name="lang">nl</field>
        <field name="body">Hallo {first_name}, factuur {invoice_number} ({invoice_total}) van {shop_name} staat klaar. Bekijk ze hier: {portal_url}</field>
    </record>
    <record id="template_invoice_posted_fr" model="textmeflow.template">
        <field name="event">invoice_posted</field>
        <field name="lang">fr</field>
        <field name="body">Bonjour {first_name}, la facture {invoice_number} ({invoice_total}) de {shop_name} est disponible. Consultez-la ici : {portal_url}</field>
    </record>
    <record id="template_invoice_posted_de" model="textmeflow.template">
        <field name="event">invoice_posted</field>
        <field name="lang">de</field>
        <field name="body">Hallo {first_name}, die Rechnung {invoice_number} ({invoice_total}) von {shop_name} liegt bereit. Hier ansehen: {portal_url}</field>
    </record>
</odoo>
