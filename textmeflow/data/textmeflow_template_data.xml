        <field name="event">order_confirmed</field>
        <field name="lang">fr</field>
        <field name="body">Bonjour {first_name}, merci pour votre commande {order_number} ({order_total}) chez {shop_name}. Consultez-la ici : {portal_url}</field>
    </record>
    <record id="template_order_confirmed_de" model="textmeflow.template">
        <field name="event">order_confirmed</field>
        <field name="lang">de</field>
        <field name="body">Hallo {first_name}, danke für Ihre Bestellung {order_number} ({order_total}) bei {shop_name}. Hier ansehen: {portal_url}</field>
    </record>
    <record id="template_delivery_done_en" model="textmeflow.template">
        <field name="event">delivery_done</field>
        <field name="lang">en</field>
        <field name="body">Hi {first_name}, your order {order_number} from {shop_name} has been shipped and is on its way. {tracking_url}</field>
    </record>
    <record id="template_delivery_done_nl" model="textmeflow.template">
