{
  "url": "https://api.textmeflow.eu/v1/accounts/me",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{parameters.apiKey}}",
    "Accept": "application/json"
  },
  "log": {
    "sanitize": ["request.headers.authorization"]
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] Invalid API key or TextMeFlow is unreachable."
    }
  }
}
