<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="template_manual_en" model="textmeflow.template">
        <field name="event">manual</field>
        <field name="lang">en</field>
        <field name="body">Hi {first_name}, this is {shop_name}. </field>
    </record>
    <record id="template_manual_nl" model="textmeflow.template">
        <field name="event">manual</field>
        <field name="lang">nl</field>
        <field name="body">Hallo {first_name}, dit is {shop_name}. </field>
    </record>
    <record id="template_manual_fr" model="textmeflow.template">
        <field name="event">manual</field>
        <field name="lang">fr</field>
        <field name="body">Bonjour {first_name}, ici {shop_name}. </field>
    </record>
    <record id="template_manual_de" model="textmeflow.template">
        <field name="event">manual</field>
        <field name="lang">de</field>
        <field name="body">Hallo {first_name}, hier ist {shop_name}. </field>
    </record>
    <record id="template_order_en" model="textmeflow.template">
        <field name="event">order</field>
        <field name="lang">en</field>
        <field name="body">Hi {first_name}, here is the link to {order_number} ({order_total}): {portal_url}</field>
    </record>
    <record id="template_order_nl" model="textmeflow.template">
        <field name="event">order</field>
        <field name="lang">nl</field>
        <field name="body">Hallo {first_name}, hier is de link naar {order_number} ({order_total}): {portal_url}</field>
    </record>
    <record id="template_order_fr" model="textmeflow.template">
        <field name="event">order</field>
        <field name="lang">fr</field>
        <field name="body">Bonjour {first_name}, voici le lien vers {order_number} ({order_total}) : {portal_url}</field>
    </record>
