    </record>
    <record id="template_invoice_fr" model="textmeflow.template">
        <field name="event">invoice</field>
        <field name="lang">fr</field>
        <field name="body">Bonjour {first_name}, voici la facture {invoice_number} ({invoice_total}), à payer avant le {due_date} : {portal_url}</field>
    </record>
    <record id="template_invoice_de" model="textmeflow.template">
