        <field name="event">order_confirmed</field>
        <field name="lang">nl</field>
        <field name="body">Hallo {first_name}, bedankt voor je bestelling {order_number} ({order_total}) bij {shop_name}. Bekijk ze hier: {portal_url}</field>
    </record>
