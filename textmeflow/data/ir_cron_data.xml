<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivers queued messages. 'numbercall' (Odoo 17 only) is set in the post-init hook. -->
    <record id="ir_cron_send_pending" model="ir.cron">
        <field name="name">TextMeFlow: send queued WhatsApp messages</field>
        <field name="model_id" ref="model_textmeflow_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_pending()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
