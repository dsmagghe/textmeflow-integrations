        <field name="event">order</field>
        <field name="lang">de</field>
        <field name="body">Hallo {first_name}, hier ist der Link zu {order_number} ({order_total}): {portal_url}</field>
    </record>
    <record id="template_order_confirmed_en" model="textmeflow.template">
        <field name="event">order_confirmed</field>
        <field name="lang">en</field>
        <field name="body">Hi {first_name}, thanks for your order {order_number} ({order_total}) at {shop_name}. You can follow it here: {portal_url}</field>
    </record>
